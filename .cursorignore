# ==== _cursor-shared master .cursorignore (managed by sync-rules.sh) ====
# Dependencies / virtual envs
node_modules/
bower_components/
vendor/
.venv/
venv/
env/
.pnpm-store/
Pods/
.dart_tool/
.pub-cache/
.gradle/

# Build outputs / caches
.next/
.nuxt/
.svelte-kit/
.turbo/
.parcel-cache/
.vite/
.expo/
.firebase/
dist/
build/
out/
target/
coverage/
.nyc_output/
DerivedData/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.min.js
*.min.css
*.map

# VCS / logs
.git/
*.log
logs/

# Large lock files
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb
Podfile.lock
pubspec.lock
poetry.lock
Cargo.lock
composer.lock
Gemfile.lock

# Media / binaries / fonts / archives
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.ico
*.bmp
*.tiff
*.psd
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.mp3
*.wav
*.m4a
*.ttf
*.otf
*.woff
*.woff2
*.eot
*.pdf
*.zip
*.rar
*.tgz
*.tar.gz
*.7z
*.apk
*.aab
*.ipa
*.dmg
*.sqlite
*.db

# Always keep important config readable
!package.json
!tsconfig.json
!tsconfig.*.json
!requirements.txt
!pyproject.toml
!Cargo.toml
!go.mod
!.env.example
!pubspec.yaml
!firebase.json
!app.json
# ==== end _cursor-shared ====
